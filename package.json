{
  "name": "school-timetable",
  "version": "0.1.0",
  "description": "Clash-free school timetable builder (frontend-only SPA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/noto-sans": "5.1.0",
    "@fontsource/noto-sans-sinhala": "5.1.0",
    "@fontsource/noto-sans-tamil": "5.1.0",
    "@pdf-lib/fontkit": "1.1.1",
    "dexie": "4.0.9",
    "html-to-image": "1.11.11",
    "immer": "10.1.1",
    "pdf-lib": "1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "regenerator-runtime": "0.14.1",
    "zod": "3.23.8",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.0.0",
    "pdfjs-dist": "4.7.76",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.4"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuwan94/school-timetable.git"
  },
  "homepage": "https://nuwan94.github.io/school-timetable/"
}
